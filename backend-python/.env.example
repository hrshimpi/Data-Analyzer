# Google Cloud / Vertex AI (required)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional — Vertex AI model id (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Path to GCP service-account key JSON (optional if using gcloud ADC)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server port (default 3001)
PORT=3001

# development | production
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Postgres (pgvector) — via `docker compose up -d` locally (see docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://orion:orion_local_password@localhost:5433/orion_data_analyzer

# ---------------------------------------------------------------------------
# S3-compatible object storage — MinIO locally, real S3/AWS in the cloud.
# Same code path either way: only S3_ENDPOINT_URL changes.
# ---------------------------------------------------------------------------
# Local (MinIO): http://localhost:9000
# Real AWS: leave blank/unset — boto3 defaults to the real AWS endpoints
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=orion-datasets-local
# Locally these are just the MinIO root user/password (see docker-compose.yml);
# in the cloud, use real IAM access keys instead.
AWS_ACCESS_KEY_ID=orion_minio
AWS_SECRET_ACCESS_KEY=orion_minio_password

# ---------------------------------------------------------------------------
# Auth — AWS Cognito
# ---------------------------------------------------------------------------
# cognito (default, secure) | local
#
# "local" accepts a single hardcoded dev token instead of verifying real
# Cognito JWTs — every request authenticates as one fixed test user. This
# is ONLY for local development with no Cognito pool set up.
#
# NEVER set AUTH_MODE=local outside your own machine — in particular,
# never set it in a deployed/shared environment. There is no real
# authentication in this mode; anyone who knows the (public, checked-into
# this repo) dev token gets full access as that user.
AUTH_MODE=local

# Required when AUTH_MODE=cognito. Create the User Pool + App Client
# (public client, no secret) manually in the AWS console first — see
# backend-python/README.md.
COGNITO_USER_POOL_ID=your-user-pool-id
COGNITO_APP_CLIENT_ID=your-app-client-id
COGNITO_REGION=us-east-1
