# Frontend API Configuration
# Points at the Python FastAPI backend by default.
VITE_API_URL=http://localhost:3001

# TEMPORARY, until a real login flow exists: sent as a Bearer token on
# every request. Only works against a backend running with AUTH_MODE=local
# (backend-python/.env) — never points at a real Cognito-protected backend.
VITE_DEV_AUTH_TOKEN=local-dev-token